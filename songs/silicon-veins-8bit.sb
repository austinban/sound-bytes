title: Silicon Veins (8-bit take)
tempo: 140

# An original chiptune piece written to match the *feel* measured from a reference track:
# ~140 bpm, F major / F minor, bass-heavy (about 45% of the energy under 100Hz), with the
# same quiet-verse / loud-chorus / long-final shape over ~2m40s. Not a transcription of the
# reference's melody.
#
# 94 bars: intro+verse 24 | chorus 12 + lift 2 | verse 12 + build 4 | final 28 | outro 12
# `bass` carries the verses, `bass_hi` (louder, more sub) takes over for the choruses.

instrument lead:    @pulse-lead volume=0.45
instrument lead2:   @square-lead volume=0.3
instrument arp:     @thin-pulse volume=0.25
instrument pluck:   @pluck volume=0.35
instrument pad:     @pad volume=0.2
instrument bass:    @triangle-bass volume=0.45 sub=0.7
instrument bass_hi: @triangle-bass volume=0.85 sub=0.95
instrument kick:    @noise-drums volume=0.75 echo=0
instrument snare:   @noise-drums volume=0.6
instrument hat:     @noise-drums volume=0.3 echo=0


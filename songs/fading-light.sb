title: Fading Light
tempo: 66

# Sad, slow ballad in A minor. 16 bars: Am | F | C | G | Am | F | E | Am, twice.
# Second half adds a heartbeat kick and a higher, more urgent melody.

instrument lead:  @square-lead volume=0.38 attack=0.03 decay=0.2 sustain=0.8 release=0.15 detune=10
instrument pad:   @pad volume=0.22
instrument arp:   @pluck volume=0.3
instrument bass:  @triangle-bass
instrument drums: @noise-drums volume=0.35

# --- melody, first pass (bars 1-8)
lead: E5:2 D5:1 C5:1       # Am
lead: C5:2 A4:2            # F
lead: E5:3 D5:1            # C
lead: D5:2 B4:2            # G
lead: E5:2 D5:1 C5:1       # Am
lead: C5:1 D5:1 C5:1 A4:1  # F
lead: B4:2 G#4:1 B4:1      # E
lead: A4:4                 # Am
# --- melody, second pass (bars 9-16), higher
lead: A5:2 G5:1 E5:1
lead: F5:2 E5:1 C5:1
lead: E5:2 G5:2
lead: D5:2 G5:1 F5:1
lead: E5:2 A5:2
lead: A5:1 G5:1 F5:1 E5:1
lead: B5:2 G#5:1 E5:1
lead: A5:4

# --- pad: one slow stepwise line, a bar per note
pad: E4:4 F4:4 E4:4 D4:4 E4:4 F4:4 G#4:4 A4:4
pad: E4:4 F4:4 E4:4 D4:4 E4:4 F4:4 G#4:4 A4:4

# --- gentle plucked arpeggios, eighth notes
arp: [A3:0.5 C4:0.5 E4:0.5 C4:0.5]x2
arp: [F3:0.5 A3:0.5 C4:0.5 A3:0.5]x2
arp: [C4:0.5 E4:0.5 G4:0.5 E4:0.5]x2
arp: [G3:0.5 B3:0.5 D4:0.5 B3:0.5]x2
arp: [A3:0.5 C4:0.5 E4:0.5 C4:0.5]x2
arp: [F3:0.5 A3:0.5 C4:0.5 A3:0.5]x2
arp: [E3:0.5 G#3:0.5 B3:0.5 G#3:0.5]x2
arp: [A3:0.5 C4:0.5 E4:0.5 C4:0.5]x2
arp: [A3:0.5 C4:0.5 E4:0.5 C4:0.5]x2
arp: [F3:0.5 A3:0.5 C4:0.5 A3:0.5]x2
arp: [C4:0.5 E4:0.5 G4:0.5 E4:0.5]x2
arp: [G3:0.5 B3:0.5 D4:0.5 B3:0.5]x2
arp: [A3:0.5 C4:0.5 E4:0.5 C4:0.5]x2
arp: [F3:0.5 A3:0.5 C4:0.5 A3:0.5]x2
arp: [E3:0.5 G#3:0.5 B3:0.5 G#3:0.5]x2
arp: [A3:0.5 C4:0.5 E4:0.5 C4:0.5]x2

# --- bass: root then fifth, half notes
bass: A2:2 E3:2
bass: F2:2 C3:2
bass: C3:2 G3:2
bass: G2:2 D3:2
bass: A2:2 E3:2
bass: F2:2 C3:2
bass: E2:2 B2:2
bass: A2:4
bass: A2:2 E3:2
bass: F2:2 C3:2
bass: C3:2 G3:2
bass: G2:2 D3:2
bass: A2:2 E3:2
bass: F2:2 C3:2
bass: E2:2 B2:2
bass: A2:4

# --- drums: silent for 8 bars, then a soft heartbeat
drums: R:32
drums: [K:1 R:0.5 K:0.5 R:2]x8

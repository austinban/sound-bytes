title: Dynamics Demo
tempo: 120

# Shows off the new shaping presets: vibrato (lead), swept pulse width (synth), tremolo (wobble, pad),
# pitch slides (slide-bass, zap). A minor: Am | F | C | G, twice.

instrument lead:   @vibrato-lead
instrument synth:  @pwm-synth volume=0.3
instrument pad:    @shimmer-pad
instrument bass:   @slide-bass
instrument wobble: @wobble-bass
instrument zap:    @zap volume=0.4
instrument drums:  @noise-drums

lead: E5:3 D5:1
lead: C5:2 A4:2
lead: E5:2 G5:2
lead: D5:4
lead: A5:2 G5:2
lead: F5:2 E5:2
lead: E5:3 D5:1
lead: C5:4

pad: [E4:4 C4:4 E4:4 D4:4]x2

bass: A2:1 R:1 A2:0.5 A2:0.5 R:1
bass: F2:1 R:1 F2:0.5 F2:0.5 R:1
bass: C3:1 R:1 C3:0.5 C3:0.5 R:1
bass: G2:1 R:1 G2:0.5 G2:0.5 R:1
bass: R:16

wobble: R:16
wobble: A2:4 F2:4 C3:4 G2:4

synth: R:16
synth: [A3:0.5 C4:0.5 E4:0.5 C4:0.5]x2
synth: [F3:0.5 A3:0.5 C4:0.5 A3:0.5]x2
synth: [C4:0.5 E4:0.5 G4:0.5 E4:0.5]x2
synth: [G3:0.5 B3:0.5 D4:0.5 B3:0.5]x2

zap: R:12
zap: R:3 A5:1
zap: R:12
zap: R:2 A5:1 A5:1

drums: [K:1 R:1 K:1 R:1]x4
drums: [K:0.5 H:0.5 S:0.5 H:0.5]x8
